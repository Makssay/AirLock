{
  "framework": "vite",
  "buildCommand": "npm run build:public",
  "outputDirectory": "dist",
  "functions": {
    "api/testnet.mjs": {
      "maxDuration": 30
    },
    "api/network.mjs": {
      "maxDuration": 15
    },
    "api/playground.mjs": {
      "maxDuration": 15
    },
    "api/playground-telegram.mjs": {
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
